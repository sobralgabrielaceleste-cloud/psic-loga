            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 15px rgba(0,0,0,0.15);
            z-index: 1000;
            transition: transform 0.3s;
        }
        .wa-flotante:hover {
            transform: scale(1.1);
        }
        .wa-flotante svg {
            width: 35px;

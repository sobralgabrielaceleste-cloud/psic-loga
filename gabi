            height: 45px;
            background-color: var(--terracota);
            color: var(--blanco);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Lora', serif;
            font-size: 1.2rem;
            margin-right: 15px;
        }
        .header-texto strong {
            color: var(--texto-oscuro);
            font-size: 1.1rem;
            display: block;
            line-height: 1.2;
        }
        .header-texto span {
            font-size: 0.85rem;
            color: #888;
        }

        /* Contenedores */
        .contenedor {
            max-width: 600px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        .contenedor-sin-padding-top {
            max-width: 600px;
            margin: 0 auto;
            padding: 0 20px 40px 20px;
        }

        /* Imágenes */
        .profile-img {
            width: 100%;
            height: auto;
            border-radius: 20px;
            object-fit: cover;
            margin-bottom: 30px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

        .img-ambiente {
            width: 100%;
            height: auto;
            max-height: 500px;
            border-radius: 20px;
            object-fit: cover;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            margin-bottom: 20px;
        }

        /* Títulos */
        h1 {
            font-size: 2.5rem;
            margin: 10px 0 20px 0;
            line-height: 1.2;
        }
        h2 {
            font-size: 2.2rem;
            margin: 10px 0 20px 0;
            line-height: 1.2;
        }
        p {
            font-size: 1.05rem;
            margin-bottom: 20px;
        }

        /* Listas personalizadas */
        .lista-ayuda {
            list-style: none;
            padding: 0;
            margin-top: 20px;
        }
        .lista-ayuda li {
            position: relative;
            padding-left: 25px;
            margin-bottom: 12px;
            font-size: 1.05rem;
        }
        .lista-ayuda li::before {
            content: '•';
            color: var(--terracota);
            font-size: 1.5rem;
            position: absolute;
            left: 0;
            top: -5px;
        }

        /* Botones */
        .btn-container {
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 30px;
        }
        .btn {
            background-color: var(--terracota);
            color: var(--blanco);
            padding: 16px 30px;
            text-decoration: none;
            border-radius: 30px;
            font-size: 1.05rem;
            font-weight: 600;
            text-align: center;
            transition: all 0.3s ease;
            box-shadow: 0 4px 10px rgba(198, 137, 114, 0.3);
        }
        .btn-outline {
            background-color: transparent;
            color: var(--terracota);
            border: 2px solid var(--terracota);
            padding: 14px 30px;
            text-decoration: none;
            border-radius: 30px;
            font-size: 1.05rem;
            font-weight: 600;
